# ── Banco de dados ──────────────────────────────────────────────────────────
# Servidor (Docker Swarm):
DATABASE_URL=postgresql://user:senha@banco:5432/n8n
# PC pessoal via SSH tunnel (mais seguro):
# DATABASE_URL=postgresql://user:SENHA@localhost:xxxx/n8n

# ── Autenticação Streamlit ──────────────────────────────────────────────────
STREAMLIT_USER=admin
STREAMLIT_PASSWORD=senha_segura

# ── LLM (escolha uma) ───────────────────────────────────────────────────────
OPENAI_API_KEY=sua_chave_openai_aqui
# ANTHROPIC_API_KEY=sua_chave_anthropic_aqui
# GOOGLE_API_KEY=sua_chave_google_aqui
# GROQ_API_KEY=sua_chave_groq_aqui

# ── API Security ─────────────────────────────────────────────────────────────
API_SECRET=chave_secreta_para_endpoints

# ── Evolution API (notificação WhatsApp pós-processamento) ──────────────────
EVOLUTION_URL=https://sua-evolution-api.com
EVOLUTION_INSTANCE=nome_da_instancia
EVOLUTION_KEY=sua_api_key_evolution
ANDREA_PHONE=5592999999999   # DDI+DDD+número, somente dígitos
